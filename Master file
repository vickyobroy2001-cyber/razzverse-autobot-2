            link = urls.get("mp4_download") or urls.get("mp4")
            if link:
                used_ids.add(vid)
                return link
    except Exception as e:
        log.warning("Coverr warning (%s): %s", query, str(e)[:100])
    return None


def _fetch_pexels_video(query, used_ids):
    key = os.environ.get("PEXELS_API_KEY", "").strip()
    if not key:
        return None
    headers = {"Authorization": key, **UA}
    for orient in ("portrait", ""):
        try:
            params = {"query": query, "per_page": 10}
            if orient:
                params["orientation"] = orient
            r = requests.get("https://api.pexels.com/videos/search", headers=headers, params=params, timeout=20)
            if r.status_code != 200:
                continue
            for v in r.json().get("videos", []):
                vid = f"pexels_{v.get('id')}"
                if vid in used_ids:
                    continue
                files = [f for f in v.get("video_files", []) if f.get("file_type") == "video/mp4" and f.get("link")]
                if not files:
                    continue
                files.sort(key=lambda f: abs((f.get("height") or 720) - 1280))
                used_ids.add(vid)
                return files[0]["link"]
        except Exception as e:
            log.warning("Pexels warning (%s): %s", query, str(e)[:100])
    return None


def _fetch_nasa_video(query, used_ids):
    """Zero-API-key public domain space/sky/star videos."""
    if not any(k in query.lower() for k in SPACE_KEYWORDS):
        return None
    try:
        r = requests.get(
            "https://images-api.nasa.gov/search",
            params={"q": query, "media_type": "video", "page_size": 5},
            headers=UA,
            timeout=20,
        )
        if r.status_code != 200:
            return None
        for item in r.json().get("collection", {}).get("items", []):
            nasa_id = (item.get("data") or [{}])[0].get("nasa_id")
            if not nasa_id or f"nasa_{nasa_id}" in used_ids:
                continue
            assets = requests.get(
                f"https://images-api.nasa.gov/asset/{urllib.parse.quote(nasa_id)}",
                headers=UA,
                timeout=15,
            )
            if assets.status_code != 200:
                continue
            mp4s = [
                a.get("href") for a 
