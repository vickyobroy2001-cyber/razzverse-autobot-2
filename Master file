def _fetch_pixabay_video(query, used_ids):
    key = os.environ.get("PIXABAY_API_KEY", "").strip()
    if not key:
        return None
    try:
        r = requests.get(
            "https://pixabay.com/api/videos/",
            params={"key": key, "q": query, "per_page": 10, "safesearch": "true"},
            headers=UA,
            timeout=20,
        )
        if r.status_code != 200:
            return None
        for hit in r.json().get("hits", []):
            vid = f"pixabay_{hit.get('id')}"
            if vid in used_ids:
                continue
            vids = hit.get("videos", {})
            link = (vids.get("medium") or vids.get("large") or vids.get("small") or {}).get("url")
            if link:
                used_ids.add(vid)
                return link
    except Exception as e:
        log.warning("Pixabay warning (%s): %s", query, str(e)[:100])
    return None


def _fetch_coverr_video(query, used_ids):
